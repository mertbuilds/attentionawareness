def _invert_table(table: bytes) -> bytes:
    inverse = bytearray(256)
    for index, value in enumerate(table):
        inverse[value] = index
    return bytes(inverse)


_INVERSE_SBOX = _invert_table(_SBOX)


def _double(value: int) -> int:
    """Multiply by two in the AES field."""
    doubled = value << 1
    return (doubled ^ 0x1B) & 0xFF if doubled & 0x100 else doubled


def _shift_rows(state: bytes) -> bytearray:
    return bytearray(state[(index + 4 * (index % 4)) % 16] for index in range(16))


def _unshift_rows(state: bytes) -> bytearray:
    return bytearray(state[(index - 4 * (index % 4)) % 16] for index in range(16))


def _mix_columns(state: bytes) -> bytearray:
    mixed = bytearray(16)
    for column in range(0, 16, 4):
        total = state[column] ^ state[column + 1] ^ state[column + 2] ^ state[column + 3]
        for row in range(4):
            here = state[column + row]
            mixed[column + row] = here ^ total ^ _double(here ^ state[column + (row + 1) % 4])
    return mixed


def _unmix_columns(state: bytes) -> bytearray:
    # The inverse mix is the mix again, after this one step over each column.
    prepared = bytearray(state)
    for column in range(0, 16, 4):
        even = _double(_double(prepared[column] ^ prepared[column + 2]))
        odd = _double(_double(prepared[column + 1] ^ prepared[column + 3]))
        prepared[column] ^= even
        prepared[column + 1] ^= odd
        prepared[column + 2] ^= even
        prepared[column + 3] ^= odd
    return _mix_columns(prepared)


class AES:
    """AES-256 on one block. Enough for key unwrapping and for one small file."""

    rounds = 14

    def __init__(self, key: bytes):
        if len(key) != 32:
            raise ValueError("AES-256 needs a key of 32 bytes.")
        words = [list(key[index:index + 4]) for index in range(0, 32, 4)]
        rcon = 1
        for index in range(8, 4 * (self.rounds + 1)):
            word = list(words[index - 1])
            if index % 8 == 0:
                word = [_SBOX[byte] for byte in word[1:] + word[:1]]
                word[0] ^= rcon
                rcon = _double(rcon)
            elif index % 8 == 4:
                word = [_SBOX[byte] for byte in word]
            words.append([left ^ right for left, right in zip(words[index - 8], word)])
        self.round_keys = [
            bytes(words[number * 4 + word][byte] for word in range(4) for byte in range(4))
            for number in range(self.rounds + 1)
        ]

    def encrypt_block(self, block: bytes) -> bytes:
        state = bytearray(left ^ right for left, right in zip(block, self.round_keys[0]))
        for number in range(1, self.rounds + 1):
            state = _shift_rows(bytearray(_SBOX[byte] for byte in state))
            if number != self.rounds:
                state = _mix_columns(state)
            state = bytearray(
                left ^ right for left, right in zip(state, self.round_keys[number])
            )
        return bytes(state)

    def decrypt_block(self, block: bytes) -> bytes:
        state = bytearray(
            left ^ right for left, right in zip(block, self.round_keys[self.rounds])
        )
        for number in range(self.rounds - 1, -1, -1):
            state = bytearray(_INVERSE_SBOX[byte] for byte in _unshift_rows(state))
            state = bytearray(
                left ^ right for left, right in zip(state, self.round_keys[number])
            )
            if number:
                state = _unmix_columns(state)
        return bytes(state)


def unwrap_key(wrapping_key: bytes, wrapped: bytes) -> bytes | None:
    """Undo an AES key wrap, RFC 3394. Return None when the key is wrong."""
    cipher = AES(wrapping_key)
    blocks = [wrapped[offset:offset + 8] for offset in range(8, len(wrapped), 8)]
    count = len(blocks)
    header = int.from_bytes(wrapped[:8], "big")
    for round_number in range(5, -1, -1):
        for index in range(count - 1, -1, -1):
            counter = count * round_number + index + 1
            plain = cipher.decrypt_block((header ^ counter).to_bytes(8, "big") + blocks[index])
            header = int.from_bytes(plain[:8], "big")
            blocks[index] = plain[8:]
    # The wrap writes a fixed header, so a wrong key shows up here.
    if header != int.from_bytes(KEY_WRAP_IV, "big"):
        return None
    return b"".join(blocks)


def aes_cbc_decrypt(key: bytes, data: bytes, iv: bytes = ZERO_IV) -> bytes:
    if len(data) % 16:
        raise Refusal("An encrypted file in this backup has a length that AES cannot hold.")
    cipher = AES(key)
    plain = bytearray()
    previous = iv
    for offset in range(0, len(data), 16):
        block = data[offset:offset + 16]
        decrypted = cipher.decrypt_block(block)
        plain += bytes(left ^ right for left, right in zip(decrypted, previous))
        previous = block
    return bytes(plain)


def aes_cbc_encrypt(key: bytes, data: bytes, iv: bytes = ZERO_IV) -> bytes:
    cipher = AES(key)
    encrypted = bytearray()
    previous = iv
    for offset in range(0, len(data), 16):
        block = data[offset:offset + 16]
        previous = cipher.encrypt_block(
            bytes(left ^ right for left, right in zip(block, previous))
        )
        encrypted += previous
    return bytes(encrypted)


def add_padding(data: bytes) -> bytes:
    """PKCS#7, the padding iOS writes at the end of an encrypted file."""
    count = 16 - len(data) % 16
    return data + bytes([count]) * count


def strip_padding(data: bytes) -> bytes:
    if not data:
        return data
    count = data[-1]
    if 1 <= count <= 16 and data[-count:] == bytes([count]) * count:
        return data[:-count]
    return data


class Keybag:
    """The class keys of a backup, read from the BackupKeyBag in Manifest.plist."""

    def __init__(self, blob: bytes):
        self.attributes: dict[bytes, object] = {}
        self.class_keys: dict[int, dict[bytes, object]] = {}
        self.read(blob)

    def read(self, blob: bytes) -> None:
        """Read the tag, length and value records. Every UUID after the first
        one starts a class key, so the first one closes the header."""
        current: dict[bytes, object] | None = None
        offset = 0
        while offset + 8 <= len(blob):
            tag = blob[offset:offset + 4]
            length = int.from_bytes(blob[offset + 4:offset + 8], "big")
            value: object = blob[offset + 8:offset + 8 + length]
            offset += 8 + length
            if length == 4:
                value = int.from_bytes(value, "big")
            if tag == b"UUID" and b"UUID" not in self.attributes:
                self.attributes[tag] = value
            elif tag == b"UUID":
                current = {}
            elif current is None:
                self.attributes[tag] = value
            elif tag in CLASS_KEY_TAGS:
                current[tag] = value
                if tag == b"CLAS":
                    self.class_keys[int(value)] = current

    def unlock(self, password: str) -> None:
        """Turn the password into the class keys. This is the slow step."""
        for tag in (b"DPSL", b"DPIC", b"SALT", b"ITER"):
            if tag not in self.attributes:
                raise Refusal(
                    "This backup holds an older keybag that this tool cannot open.\n"
                    "Make a new backup in Finder, then run this command again."
                )
        print("Deriving the backup keys. This takes up to about ten seconds.", file=sys.stderr)
        first = hashlib.pbkdf2_hmac(
            "sha256",
            password.encode("utf-8"),
            self.attributes[b"DPSL"],
            self.attributes[b"DPIC"],
            32,
        )
        password_key = hashlib.pbkdf2_hmac(
            "sha1", first, self.attributes[b"SALT"], self.attributes[b"ITER"], 32
        )
        for entry in self.class_keys.values():
            wrapped = entry.get(b"WPKY")
            if wrapped is None or not int(entry.get(b"WRAP", 0)) & WRAP_PASSCODE:
                continue
            key = unwrap_key(password_key, wrapped)
            if key is None:
                raise Refusal(WRONG_PASSWORD_HELP)
            entry[b"KEY"] = key

    def unwrap_for_class(self, protection_class: int, wrapped: bytes) -> bytes:
        entry = self.class_keys.get(protection_class) or {}
        class_key = entry.get(b"KEY")
        if class_key is None:
            raise Refusal(
                "The keybag of this backup holds no key for protection class "
                f"{protection_class}."
            )
        key = unwrap_key(class_key, wrapped)
        if key is None:
            raise Refusal(WRONG_PASSWORD_HELP)
        return key


@dataclass
class BackupKeys:
    """The keys of one encrypted backup. They stay in memory and reach no file."""

    keybag: Keybag
    manifest: bytes
    file: bytes | None = None


def unlock_backup(manifest: dict, password: str) -> BackupKeys:
    blob = manifest.get("BackupKeyBag")
    manifest_key = manifest.get("ManifestKey")
    if not blob or not manifest_key:
        raise Refusal(
            "This encrypted backup holds no keybag, so this tool cannot open it.\n"
            "Make a new backup in Finder, then run this command again."
        )
    keybag = Keybag(bytes(blob))
    keybag.unlock(password)
    manifest_key = bytes(manifest_key)
    # Four bytes of protection class, then the wrapped key.
    protection_class = int.from_bytes(manifest_key[:4], "little")
    return BackupKeys(
        keybag=keybag,
        manifest=keybag.unwrap_for_class(protection_class, manifest_key[4:]),
    )


