# Encrypted backups
#
# Finder keeps the keys of an encrypted backup in Manifest.plist. The backup
# password unlocks the keybag there, the keybag unwraps the key of Manifest.db
# and the key of every file, and each file is AES-256-CBC with a zero IV. The
# standard library holds no AES, so this is a small one. It runs the key
# unwrapping and the one small file this tool patches. Manifest.db is too big
# for it, so that file goes to the openssl binary.

ZERO_IV = b"\x00" * 16
KEY_WRAP_IV = b"\xa6" * 8
WRAP_PASSCODE = 2
CLASS_KEY_TAGS = (b"CLAS", b"WRAP", b"WPKY", b"KTYP", b"PBKY")

WRONG_PASSWORD_HELP = (
    "Wrong backup password.\n"
    "This is the password you set in Finder for the encrypted backup. "
    "It is not the passcode of the iPhone."
