{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@attentionawareness/web#build": {
      "dependsOn": ["^build"],
      // prebuild copies the CLI into public/, so a new CLI build must miss the cache.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/cli/dist/supervise"],
      "outputs": ["dist/**", "src/routeTree.gen.ts", "src/paraglide/**"]
    },
    "@attentionawareness/web#typecheck": {
      "dependsOn": ["@attentionawareness/web#build"]
    }
  }
}
