# dependencies
node_modules/

# build output
dist/
# the single-file build is committed; install.sh downloads it from the repo
!cli/dist/
.output/
.vite/
storybook-static/

# caches
.turbo/
.wrangler/
coverage/
*.tsbuildinfo

# env — only the example is committed
.env*
!.env.example

# generated code (rebuilt by dev:setup / build)
packages/db/generated/
apps/web/src/paraglide/
apps/web/src/routeTree.gen.ts
apps/web/worker-configuration.d.ts

# licensed fonts — fetched by scripts/fetch-fonts.sh, never committed
packages/ui/fonts/*.woff2

# e2e artifacts
playwright-report/
test-results/

# os
.DS_Store

# python (cli/)
__pycache__/
*.py[cod]
.venv/
