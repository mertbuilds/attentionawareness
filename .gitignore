# dependencies
node_modules/

# build output
dist/
.output/
.vite/
storybook-static/
# the packed extension, rebuilt by `pnpm --filter @attentionawareness/extension zip`
apps/extension/*.zip

# caches
.turbo/
.cloudflare/
.wrangler/
apps/web/.tanstack/
*.tsbuildinfo

# env — only the example is committed
.env*
!.env.example
# worker secrets for `vite dev` (Cloudflare plugin, repo root); only the example is committed
.dev.vars
!.dev.vars.example

# generated code (rebuilt by build)
apps/web/src/paraglide/
apps/web/src/routeTree.gen.ts

# licensed fonts — fetched by scripts/fetch-fonts.sh, never committed
packages/ui/fonts/*.woff2
# Special Elite is under the Apache License 2.0, so its file is in the repo
!packages/ui/fonts/SpecialElite-Regular.woff2
# the Suisse Intl files apps/mac/scripts/dmg-background.html renders with
apps/mac/scripts/fonts/

# the Mac app (Xcode). build/ is the usual derived data path, build-estimate/
# and build-release/ are second ones for building beside a run
apps/mac/build/
apps/mac/build-estimate/
apps/mac/build-release/
apps/mac/DerivedData/
# generated by xcodegen from apps/mac/project.yml, which is the source of truth
apps/mac/*.xcodeproj/
apps/mac/**/xcuserdata/
apps/mac/**/*.xcuserstate
# filled by apps/mac/scripts/vendor.sh; only the module map is tracked
apps/mac/Vendor/*
!apps/mac/Vendor/include/
apps/mac/Vendor/include/*
!apps/mac/Vendor/include/module.modulemap

# os
.DS_Store
