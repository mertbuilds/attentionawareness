# dependencies
node_modules/

# build output
dist/
# the single-file build is committed; the web build copies it into public/
!cli/dist/
.output/
.vite/
storybook-static/
# the packed extension, rebuilt by `pnpm --filter @attentionawareness/extension zip`
apps/extension/*.zip
# the CLI the site serves, copied from cli/dist by the web prebuild script
apps/web/public/cli/
# the Mac app the site serves: the dmg is a release artifact, the two small
# files beside it (appcast.xml, latest.json) are committed
apps/web/public/mac/*.dmg

# caches
.turbo/
.wrangler/
apps/web/.tanstack/
coverage/
*.tsbuildinfo

# env — only the example is committed
.env*
!.env.example
# worker secrets for `wrangler dev` — only the example is committed
.dev.vars
!.dev.vars.example

# generated code (rebuilt by build)
apps/web/src/paraglide/
apps/web/src/routeTree.gen.ts
apps/web/worker-configuration.d.ts

# licensed fonts — fetched by scripts/fetch-fonts.sh, never committed
packages/ui/fonts/*.woff2

# e2e artifacts
playwright-report/
test-results/

# os
.DS_Store

# python (cli/)
__pycache__/
*.py[cod]
.venv/
