# Copy to .env for local development. Every var validated in packages/env.
# The site is static and client-only — nothing here is required to run it.
# Local URLs are served by portless (https://portless.sh): named HTTPS .localhost
# domains instead of ports.

# --- Client (Vite, apps/web) ---
# VITE_POSTHOG_KEY=
# VITE_SENTRY_DSN=

# --- Web worker (wrangler secrets in production) ---
# AXIOM_TOKEN=
# AXIOM_DATASET=
