# Copy to .env for local development. Every var validated in packages/env.
# The site is static and client-only — nothing here is required to run it.
# Local URLs are served by portless (https://portless.sh): named HTTPS .localhost
# domains instead of ports.

# --- Client (Vite, apps/web) ---
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# VITE_SENTRY_DSN=

# --- Web worker (Worker secrets in production) ---
# Bound only once declared with bindings.secret() in apps/web/cloudflare.config.ts,
# which they are not yet; declare them and set them on the Worker together.
# AXIOM_TOKEN=
# AXIOM_DATASET=

# --- Profile signing (Worker secrets only, never here) ---
# SIGNING_CERT_PEM, SIGNING_CHAIN_PEM and SIGNING_KEY_PKCS8_PEM carry the
# Developer ID certificate, the Apple intermediate and the private key.
# Local: .dev.vars at the repo root (see .dev.vars.example).
# Production: `cf workers secrets update <name>`. See docs/signing.md.
