# Copy to .env for local development. Every var validated in packages/env.
# Local URLs are served by portless (https://portless.sh): named HTTPS .localhost
# domains instead of ports. Postgres and emulate stay port-based (portless is HTTP-only).

# --- Required ---
DATABASE_URL=postgresql://keepyourattention:keepyourattention@localhost:5433/keepyourattention

# --- Server (optional locally; features off when unset) ---
NODE_ENV=development
# Fallback port when the api runs without portless (portless injects PORT, which wins).
API_PORT=3001
WEB_URL=https://keepyourattention.localhost

# Better Auth (chunk 4)
# BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://api.keepyourattention.localhost

# Google OAuth — emulate.dev locally
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Point at the emulate.dev Google emulator locally (switches to genericOAuth + OIDC discovery)
# GOOGLE_ISSUER_BASE=https://google.emulate.localhost  (plain http://localhost:5101 if portless proxy is off)

# Stripe — point at emulate.dev locally (STRIPE_API_BASE), real test keys in staging.
# Local defaults match emulate.config.yaml (any sk_test_ value works against emulate).
STRIPE_SECRET_KEY=sk_test_emulate
STRIPE_WEBHOOK_SECRET=whsec_local_emulate
STRIPE_API_BASE=https://stripe.emulate.localhost
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_local

# Resend — emulate.dev locally
# RESEND_API_KEY=
# Point at the emulate.dev Resend emulator locally
# RESEND_API_BASE=https://resend.emulate.localhost  (plain http://localhost:5102 if portless proxy is off)

# Observability (off locally by default)
# SENTRY_DSN=
# AXIOM_TOKEN=
# AXIOM_DATASET=
# POSTHOG_KEY=

# --- Client (Vite, apps/web) ---
VITE_API_URL=https://api.keepyourattention.localhost
# VITE_POSTHOG_KEY=
# VITE_SENTRY_DSN=
