{
  "name": "@attentionawareness/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.config.content.ts && vite build --config vite.config.background.ts",
    "e2e": "playwright test",
    "store:shots": "node scripts/store-shots.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "zip": "pnpm build && node scripts/zip.ts"
  },
  "dependencies": {
    "@attentionawareness/ui": "workspace:*",
    "@stylexjs/stylex": "^0.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@attentionawareness/config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@stylexjs/unplugin": "^0.19.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "css-tree": "^3.2.1",
    "jsdom": "30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  }
}
