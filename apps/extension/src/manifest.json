{
  "manifest_version": 3,
  "name": "attention awareness",
  "description": "Removes the feeds that farm your attention. X, YouTube, Instagram, plus your own CSS.",
  "version": "0.2.0",
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "*://x.com/*",
    "*://twitter.com/*",
    "*://*.youtube.com/*",
    "*://*.instagram.com/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "all_frames": false,
      "js": ["content.js"],
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*",
        "*://*.youtube.com/*",
        "*://*.instagram.com/*"
      ],
      "run_at": "document_start"
    }
  ]
}
