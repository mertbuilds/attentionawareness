{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "attentionawareness-web",
  "account_id": "e13d54eaa30780f8012d3f192ea0fecd",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Custom entry: wraps @tanstack/react-start/server-entry with paraglide + evlog.
  "main": "src/server.ts",
  // The apex is the canonical host. The other three are custom domains on this
  // same Worker so `canonicalRedirect` in src/server.ts can 301 them itself.
  "routes": [
    { "pattern": "attentionawareness.com", "custom_domain": true },
    { "pattern": "www.attentionawareness.com", "custom_domain": true },
    { "pattern": "keepyourattention.com", "custom_domain": true },
    { "pattern": "www.keepyourattention.com", "custom_domain": true },
    { "pattern": "dikkatfarkindaligi.com", "custom_domain": true },
    { "pattern": "www.dikkatfarkindaligi.com", "custom_domain": true },
  ],
  // Static assets answer before the Worker, so a file under public/ would shadow
  // a route of the same path. These paths stay with the Worker whatever lands
  // in public/. `/mac/*` is the Mac app's files, read from R2 below.
  "assets": {
    "run_worker_first": ["/guides", "/guides/*", "/extension/*", "/mac/*"],
  },
  // The Mac app's files (the Sparkle feed, `latest.json`, the versioned dmgs),
  // answered by `macFileResponse` in src/lib/mac-files.ts. The key is the URL
  // path without its leading slash: /mac/appcast.xml is `mac/appcast.xml`.
  // `vite dev` reads a local simulation under .wrangler/state instead.
  "r2_buckets": [{ "binding": "MAC_FILES", "bucket_name": "attentionawareness-mac" }],
  // evlog ships logs itself; Workers observability would duplicate them.
  "observability": {
    "enabled": false,
  },
}
