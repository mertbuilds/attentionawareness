.DS_Store
build/
# a second derived data path, for building while a run is going in build/
build-estimate/
# generated by xcodegen from project.yml, which is the source of truth
*.xcodeproj/
# filled by scripts/vendor.sh from Homebrew; only the module map is tracked
Vendor/*
!Vendor/include/
Vendor/include/*
!Vendor/include/module.modulemap
